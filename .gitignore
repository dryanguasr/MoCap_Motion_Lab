# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Models downloaded locally
models/*.task

# Raw experimental data
# Keep folder structure but never version source recordings by default.
data/raw/*
!data/raw/.gitkeep

# Processed experimental data
# Results can become very large (per-frame CSV/NPZ, overlays, diagnostics, caches,
# etc.). Keep them local and version only compact human-readable summaries.
data/processed/**
!data/processed/.gitkeep
!data/processed/**/
!data/processed/**/REPORT.md
!data/processed/**/summary.json
!data/processed/**/*_summary.json
!data/processed/**/*_summary.csv

# Generic video exports
*.mp4
*.avi
*.mov
*.mkv

# Large/generated numerical artifacts anywhere in the repository
*.npz
*.npy
